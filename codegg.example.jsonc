{
  // Full annotated example of a CodeGG configuration file.
  //
  // Every block below parses against the current schema and is checked by
  // `codegg validate --config codegg.example.jsonc`. Several keys are
  // untagged enums whose accepted shapes are easy to get wrong, so the
  // exact types are noted inline.
  //
  // Discovery order (crates/codegg-config/src/paths.rs):
  //   CODEGG_TUI_CONFIG -> system -> global -> project (upward walk).
  // Unknown keys are ignored rather than rejected, so a typo is silent.
  "$schema": "https://opencode.ai/schema/config.json",
  "version": "1",
  "log_level": "info",

  // Optional semantic model routing. Select "virtual:code" to run a bounded
  // selector decision; concrete model selections bypass this policy. CodeGG
  // applies only a route compatible with the already-selected connection.
  "model_routers": {
    "virtual:code": {
      "selector_model": "openai/gpt-4o-mini",
      "default_model": "openai/gpt-4o-mini",
      // Retained for shared policy/fingerprint compatibility. CodeGG does not
      // maintain an EggPool-style local affinity cache.
      "sticky": false,
      "routes": {
        "fast": {
          "model": "openai/gpt-4o-mini",
          "description": "short implementation task"
        }
      }
    }
  },

  // Default model. Accepts "provider/model-id" or a bare "model-id".
  "model": "anthropic/claude-sonnet-4-20250514",
  // Optional cheaper model for background/summarization work.
  "small_model": "anthropic/claude-haiku-4-20250514",

  "username": "your-username",
  // Session sharing: one of "manual", "auto", "disabled".
  "share": "disabled",

  // Accepted for backward compatibility but INERT: no production code path
  // reads it and nothing schedules an upgrade automatically.
  // `codegg upgrade` runs only on explicit user invocation.
  // Accepted shapes are a boolean or a string (untagged enum).
  "autoupdate": false,

  // HTTP/WebSocket server. Only reachable when built with the `server`
  // Cargo feature.
  "server": {
    "port": 3000,
    "hostname": "127.0.0.1",
    "mdns": false,
    "mdns_domain": "opencode.local",
    "cors_origins": ["https://opencode.ai"],
    "tool_timeout_seconds": 120,
    "max_parallel_tools": 5
  },

  "model_profile": {
    "openai/gpt-5": {
      "task_state_policy": {
        "mode": "explicit_todo",
        "update_frequency": "milestones_and_task_switches",
        "max_total_items": 10,
        "expose_completed_items": "summary_only",
        "allow_model_todo_read": true,
        "allow_model_todo_write": true,
        "require_single_in_progress": true,
        "require_blocker_reason": false,
        "inject_after_tool_calls": 5,
        "inject_on_resume": true,
        "inject_after_compaction": true,
        "subagent_todo_access": "none"
      }
    }
  },

  "provider": {
    // Each provider below independently checks its config block and then its
    // conventional env var (e.g. ANTHROPIC_API_KEY), so declaring one here
    // does not disable env-var credentials for the others.
    "anthropic": {
      "auth": { "type": "api_key", "env": "ANTHROPIC_API_KEY" },
      "base_url": "https://api.anthropic.com",
      // `timeout` is an untagged enum: integer MILLISECONDS, or a boolean.
      // A duration string such as "60s" is rejected and invalidates the file.
      "timeout": 60000,
      "whitelist": ["claude-sonnet-4-20250514", "claude-opus-4-20250514"]
    },
    "openai": {
      "auth": { "type": "api_key", "env": "OPENAI_API_KEY" },
      "base_url": "https://api.openai.com/v1",
      "timeout": 30000,
      "options": {
        "max_retries": 3
      }
    },
    "google": {
      "auth": { "type": "api_key", "env": "GOOGLE_API_KEY" },
      "timeout": 45000
    },
    "openrouter": {
      "auth": { "type": "api_key", "env": "OPENROUTER_API_KEY" },
      "base_url": "https://openrouter.ai/api/v1"
    },
    "opencode_zen": {
      "auth": { "type": "api_key", "env": "OPENCODE_ZEN_API_KEY" },
      "base_url": "https://opencode.ai/zen/v1",
      "models": {
        "minimax-m2.5-free": {
          "context_window": 200000,
          "max_output_tokens": 64000,
          "supports_tools": true
        }
      }
    },
    "xai": {
      "auth": { "type": "api_key", "env": "XAI_API_KEY" }
    }
  },

  // Provider auth modes
  //
  // Each `provider.<id>.auth` block uses one of:
  //
  //   { "type": "api_key", "env": "VENDOR_API_KEY" }      - read from env (default fallback {VENDOR}_API_KEY)
  //   { "type": "api_key", "value": "sk-..." }           - inline (avoid; prefer env or store)
  //   { "type": "api_key", "encrypted_value": "v2:..." } - encrypted at rest
  //   { "type": "stored", "account_id": "default" }      - resolve from user credential store
  //                                                      (stored `BearerToken` records resolve only
  //                                                       for `ApiKeyOrBearer` providers: mistral,
  //                                                       groq, deepinfra, cerebras, cohere,
  //                                                       together, perplexity, xai, venice,
  //                                                       opencode_go, generalcompute; all other
  //                                                       built-ins reject bearer with typed
  //                                                       Unsupported; expired records fail as
  //                                                       Expired before network)
  //   { "type": "external_command", "command": "...", "args": ["..."], "timeout_ms": 5000 }
  //                                                      - parsed; the synchronous resolver and
  //                                                        ExternalCommandProvider::fetch both
  //                                                        return AuthError::Unsupported until
  //                                                        async timeout plumbing is in place
  //   { "type": "oauth_device", "client_id": "...", "auth_url": "...", "token_url": "..." }
  //                                                      - typed but not yet implemented
  //   { "type": "none" }                                  - explicit no-auth marker
  //
  // Legacy: the original `api_key` and `encrypted_api_key` fields on the
  // provider object are still honored as a fallback. They are read by
  // `AuthResolver` (single resolution path), not by the registration
  // helper directly.
  //
  // Stored credentials live in <config_dir>/codegg/credentials.json (for
  // example ~/.config/codegg/credentials.json on Linux, or
  // ~/Library/Application Support/codegg/credentials.json on macOS). They do
  // NOT require any environment variable: the first protected write creates
  // and persists a CodeGG-managed key at <config_dir>/codegg/master.key.
  // CODEGG_MASTER_KEY, CODEGG_ENCRYPTION_KEY and OPENCODE_ENCRYPTION_KEY are
  // optional higher-precedence overrides for deployments that manage key
  // material externally. If existing ciphertext was created with an external
  // key and that key is later unavailable, CodeGG fails closed rather than
  // replacing it.
  //
  // Manage the store with `codegg auth status`, `codegg auth set-key <provider>`
  // (reads the key from stdin), and `codegg auth logout <provider>`. The CLI
  // validates provider and account ids (`[A-Za-z0-9_-]`, with `*` allowed for
  // `logout` only) and never echoes key material.

  // MCP servers are keyed DIRECTLY under `mcp` - there is no `servers` wrapper.
  // Also manageable from the CLI: `codegg mcp add|list|remove|enable|debug`.
  "mcp": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "env": {}
    }
  },

  // Permissions are declared PER TOOL, not as allow/deny lists. Each value is
  // an untagged enum: either an action string, or an object whose values are
  // all strings.
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": "ask",
    "edit": "ask",
    // Bash patterns are global, not per-rule.
    "bash_allow_patterns": ["git status", "git diff", "git log"],
    "bash_deny_patterns": ["rm -rf", "git push --force"],
    "tools": {
      "webfetch": "allow"
    }
  },

  "compaction": {
    "enabled": true,
    "auto": true,
    "prune": false,
    "max_tokens": 200000,
    "threshold": 0.8,
    "reserved": 10000
  },

  // Additional skill locations, on top of the automatically discovered
  // .codegg/skills, .agents/skills, .opencode/skills and .claude/skills roots.
  "skills": {
    "enabled": true,
    "paths": ["./docs/skills"]
  },

  // Custom slash commands. `template` is REQUIRED (a natural-language
  // instruction); `command`/`args` are the executable and are only used when
  // `runtime` is "process".
  "commands": {
    "test": {
      "template": "Run the project test suite and summarize failures",
      "description": "Project test suite",
      "agent": "build",
      "runtime": "process",
      "command": "npm",
      "args": ["test"],
      "timeout_ms": 120000
    }
  },

  // Per-tool enable/disable switches.
  "tools": {
    "bash": true,
    "read": true,
    "edit": true,
    "glob": true,
    "grep": true,
    "apply_patch": true,
    "multiedit": true,
    "webfetch": true,
    "question": true
  },

  // Formatters are keyed DIRECTLY by file extension - there is no `rules`
  // wrapper.
  "formatter": {
    "rs": {
      "command": ["rustfmt", "$FILE"],
      "disabled": false
    },
    "ts": {
      "command": ["prettier", "--write", "$FILE"],
      "disabled": false
    }
  },

  // LSP servers are keyed DIRECTLY by builtin server id - there is no
  // `servers` wrapper, and the key is the server id (not a language name):
  // rust-analyzer, gopls, pyright, typescript-language-server, clangd, ...
  // Each active rule requires `command` as an ARRAY of strings; the executable
  // and its flags both belong in that array, and there is no `args` field.
  // Run `codegg doctor lsp` to see which servers are active in your setup.
  "lsp": {
    "rust-analyzer": {
      "command": ["rust-analyzer"]
    },
    "typescript-language-server": {
      "command": ["typescript-language-server", "--stdio"]
    }
  },

  "watcher": {
    "ignore": ["**/target/**", "**/node_modules/**"],
    "debounce_duration_ms": 500
  },

  // WASM plugin manifests, as paths. Each entry is a string (or a
  // [path, options] pair), NOT an object.
  "plugin": [
    "./plugins/custom.wasm"
  ],

  // Experimental flags. Each one gates an unstable feature; check
  // `codegg doctor lsp` for the current value of an individual gate.
  "experimental": {
    "batch_tool": true,
    "lsp_tool": true
  },

  "theme": {
    "name": "cyber-red",
    // Custom theme directories must be listed explicitly; nothing is scanned
    // from the platform config directory implicitly.
    "directories": ["./themes"]
  },

  // Keybind overrides: "<modifiers>+<key>" -> action.
  // Modifiers are ctrl|control, shift, alt; the key is enter, esc, tab,
  // backspace, delete, left, right, up, down, home, end, pageup, pagedown,
  // space, or a single character. Action values are snake_case names from the
  // ActionKey enum (send, newline, cancel, clear_session, new_session,
  // toggle_sidebar, switch_agent, select_model, navigate_up, ...).
  // An unparseable key or an unknown action is silently ignored.
  "keybinds": {
    "ctrl+enter": "send",
    "ctrl+l": "clear_session",
    "ctrl+p": "switch_agent"
  },

  "instructions": [
    "Always write tests before committing code",
    "Use meaningful commit messages"
  ]
}
