{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeGG",
  "version": "0.1.0",
  "identifier": "dev.codegg.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "CodeGG", "width": 1000, "height": 720, "url": "index.html" }],
    "security": { "csp": "default-src 'self' asset: http://tauri.localhost; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://tauri.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": { "active": true, "targets": "all", "resources": { "binaries/codegg": "codegg" } }
}
