//! Render `architecture/tool-catalog.md` from the real tool registry.
//!
//! The catalog's only input is [`ToolRegistry::with_options`] — the single
//! authoritative registration sequence — so a row cannot exist that the binary
//! would not register, and a registered tool cannot be left out. There is no
//! hand-written list here and no TOML mirror: that would be the same defect as
//! the document this file replaces.
//!
//! Four declared option sets are catalogued. Each is a `ToolRegistryOptions`
//! value plus, for the two profiles that narrow **after** registration, the
//! declared allowlist production narrows with. Narrowing after registration is
//! not a shortcut: `src/agent/worker.rs` builds the child registry through
//! `with_options` and then calls `filter_out`/`retain_only`, and plan mode is a
//! surface filter over the same registry (`src/tool/disclosure.rs`). The catalog
//! renders what those steps leave behind, using their own constants.
//!
//! Regenerate with:
//!
//! ```text
//! CODEGG_UPDATE_TOOL_CATALOG=1 cargo test --test tool_catalog
//! ```
//!
//! See `plans/implementation/harness-practice-adoption/004-generated-tool-surface-catalog.md`.

use std::fmt::Write as _;
use std::path::{Path, PathBuf};

use codegg::tool::backend::{
    ExternalToolBackendConfig, ToolBackendConfig, ToolImplementationBackend,
};
use codegg::tool::contract::ToolCallerPolicy;
use codegg::tool::disclosure::{disclosure_for, ToolDisclosure, PLAN_ALLOWED};
use codegg::tool::git::ChildGitPolicy;
use codegg::tool::{Tool, ToolRegistry, ToolRegistryOptions};

/// The exact first line of the generated catalog.
///
/// `scripts/check_tool_catalog.py` requires it character for character, so a
/// hand-edited file is rejected even when the rows happen to match.
pub(crate) const GENERATED_HEADER: &str =
    "<!-- AUTO-GENERATED by tests/tool_catalog/render.inc — DO NOT EDIT -->";

/// The command that regenerates the catalog, quoted in its second line.
pub(crate) const UPDATE_COMMAND: &str =
    "CODEGG_UPDATE_TOOL_CATALOG=1 cargo test --test tool_catalog";

/// The declared sentinel workspace root every catalogued registry is built
/// with.
///
/// A path has to exist for the *shape* of the registry — with
/// `workspace_root: None` the registry replaces every workspace-scoped tool
/// with a refusing `UnrootedTool` stub, which is a different surface and not a
/// documentation of the coding surface. No tool reads, creates, or canonicalises
/// this path at construction time, and it never reaches the rendered text: the
/// catalog asserts its own absence.
pub(crate) const WORKSPACE_ROOT: &str = "/codegg-tool-catalog-workspace";

/// One catalogued surface.
pub(crate) struct Surface {
    /// The section header, and the name `scripts/check_tool_catalog.py`
    /// declares. Sections render in this array's order.
    pub(crate) name: &'static str,
    /// What this option set is, in one line, in the reader's terms.
    pub(crate) description: &'static str,
    /// The option set, constructed per render so no registry outlives a render.
    pub(crate) options: fn() -> ToolRegistryOptions,
    /// The allowlist the profile narrows the registry to after registration,
    /// or `None` when the option set alone decides the surface.
    pub(crate) retention: Option<&'static [&'static str]>,
}

/// The declared matrix, in section order.
pub(crate) const SURFACES: &[Surface] = &[
    Surface {
        name: "default",
        description: "An ordinary session: `ToolRegistryOptions::default()` with a resolved \
                      workspace root, no session pool and no daemon-issued LSP scope.",
        options: default_options,
        retention: None,
    },
    Surface {
        name: "plan-mode",
        description: "Plan mode's advertised surface: the same registry narrowed to the \
                      disclosure owner's `PLAN_ALLOWED` allowlist. Every other tool is omitted \
                      with `ToolOmissionReason::PlanMode`.",
        options: default_options,
        retention: Some(PLAN_ALLOWED),
    },
    Surface {
        name: "restricted-subagent",
        description: "The read-only child a reserved managed checkout gets: a local-commit child \
                      Git policy, a read-only sandbox profile, and the worker's \
                      `retain_only(&[\"read\", \"list\", \"glob\"])`.",
        options: restricted_subagent_options,
        retention: Some(&["read", "list", "glob"]),
    },
    Surface {
        name: "backend-disabled",
        description: "The same session with the `lsp` and `security` domains configured as \
                      `disabled` in `[tool_backends]`. Each domain keeps its stable tool name and \
                      hides itself from the model's definitions.",
        options: backend_disabled_options,
        retention: None,
    },
];

/// `default` with a resolved root. Everything else is the registry's own
/// default, so the section drifts only when the registry's default does.
fn default_options() -> ToolRegistryOptions {
    ToolRegistryOptions {
        workspace_root: Some(PathBuf::from(WORKSPACE_ROOT)),
        ..ToolRegistryOptions::default()
    }
}

/// `src/agent/worker.rs`'s restricted child: child Git authority, a read-only
/// sandbox profile, and the three workspace reads the profile retains.
fn restricted_subagent_options() -> ToolRegistryOptions {
    ToolRegistryOptions {
        workspace_root: Some(PathBuf::from(WORKSPACE_ROOT)),
        child_git_policy: Some(ChildGitPolicy::LocalCommitOnly),
        sandbox_profile: Some(codegg_core::approval::SandboxProfile::ReadOnly),
        ..ToolRegistryOptions::default()
    }
}

/// `default`, with the two domains that own a refusal stub configured as
/// `disabled`.
fn backend_disabled_options() -> ToolRegistryOptions {
    let disabled = || ExternalToolBackendConfig {
        backend: Some(ToolImplementationBackend::Disabled),
        ..ExternalToolBackendConfig::default()
    };
    ToolRegistryOptions {
        tool_backends: ToolBackendConfig {
            lsp: Some(disabled()),
            security: Some(disabled()),
            context: Some(disabled()),
        },
        ..default_options()
    }
}

/// Build the registry one surface declares.
pub(crate) fn build_registry(surface: &Surface) -> ToolRegistry {
    let mut registry = ToolRegistry::with_options((surface.options)());
    if let Some(retention) = surface.retention {
        registry.retain_only(retention);
    }
    registry
}

/// One rendered row.
#[derive(Debug)]
pub(crate) struct Row {
    pub(crate) name: String,
    pub(crate) category: &'static str,
    pub(crate) effect_class: &'static str,
    pub(crate) defer_load: bool,
    pub(crate) visibility: String,
}

/// The prefix `DisabledTool` advertises in the schema description it hands the
/// model (`"Disabled: {reason}"`).
///
/// It is the stub's own contract, and the only place it exposes its reason
/// without being executed — which is why the renderer quotes what follows it
/// instead of carrying a table of reasons.
const DISABLED_REFUSAL_PREFIX: &str = "Disabled: ";

/// Why a tool that hides itself from the model's definitions says so.
///
/// Three gates exist in the registry, and each one is read from the tool, never
/// asserted here:
///
/// 1. a `DisabledTool` stub advertises its configured refusal in its schema;
/// 2. a program-only adapter declares `ToolCallerPolicy::ProgrammaticOnly` in
///    its own `ToolContract` (`git_read`, `lsp_read`);
/// 3. a tool whose declared disclosure state is `ToolDisclosure::Hidden` is
///    never model-visible (`invalid`, the `codesearch` compat alias).
///
/// Anything else returns `None`, and the renderer fails rather than inventing a
/// reason: a hidden tool with no stated cause is a hole in the contract, not a
/// row to paper over.
fn hidden_reason(tool: &dyn Tool) -> Option<String> {
    if let Some(text) = tool
        .parameters()
        .get("description")
        .and_then(|value| value.as_str())
    {
        if let Some(reason) = text.strip_prefix(DISABLED_REFUSAL_PREFIX) {
            return Some(reason.to_string());
        }
    }
    if tool.contract(tool.name(), tool.parameters()).caller_policy
        == ToolCallerPolicy::ProgrammaticOnly
    {
        return Some("programmatic-only caller policy".to_string());
    }
    if disclosure_for(tool.name()) == ToolDisclosure::Hidden {
        return Some("declared disclosure state is `hidden`".to_string());
    }
    None
}

/// The safety class, spelled as `src/tool/catalog.rs` spells it for
/// diagnostics.
fn category_label(tool: &dyn Tool) -> &'static str {
    match tool.category() {
        codegg::tool::ToolCategory::ReadOnly => "ReadOnly",
        codegg::tool::ToolCategory::SafeMutating => "SafeMutating",
        codegg::tool::ToolCategory::Mutating => "Mutating",
        codegg::tool::ToolCategory::ShellExec => "ShellExec",
    }
}

/// Render one row, or fail naming the tool whose metadata is unusable.
pub(crate) fn render_row(tool: &dyn Tool) -> Result<Row, String> {
    let name = tool.name();
    if name.is_empty() {
        return Err("a registered tool reports an empty name".to_string());
    }
    let contract = tool.contract(name, tool.parameters());
    let visibility = if tool.expose_in_definitions() {
        "visible".to_string()
    } else {
        match hidden_reason(tool) {
            Some(reason) if !reason.trim().is_empty() => format!("hidden ({reason})"),
            Some(_) => {
                return Err(format!(
                    "`{name}` advertises an empty refusal reason; a hidden tool must state why"
                ));
            }
            None => {
                return Err(format!(
                    "`{name}` hides itself from the model's definitions but names no reason: \
                     its schema advertises no refusal, its contract is not programmatic-only, \
                     and its disclosure state is not `hidden`"
                ));
            }
        }
    };
    Ok(Row {
        name: name.to_string(),
        category: category_label(tool),
        effect_class: contract.effect_class.as_str(),
        defer_load: tool.defer_loading(),
        visibility,
    })
}

/// Every row of one surface, sorted by tool name.
///
/// A registry hands its tools out in hash order, so the sort is what makes the
/// artifact deterministic; two renders on one baseline are byte-identical
/// because nothing here reads a clock, an environment value, or a path.
pub(crate) fn render_rows(surface: &Surface) -> Result<Vec<Row>, String> {
    let registry = build_registry(surface);
    let mut rows = Vec::new();
    for tool in registry.list() {
        rows.push(render_row(tool).map_err(|error| format!("{}: {error}", surface.name))?);
    }
    rows.sort_by(|left, right| left.name.cmp(&right.name));
    Ok(rows)
}

/// Render the catalog.
pub(crate) fn render_catalog() -> String {
    let mut rendered = Vec::new();
    for surface in SURFACES {
        match render_rows(surface) {
            Ok(rows) => rendered.push((surface, rows)),
            // A surface that cannot be rendered is a hard failure: falling back
            // to a smaller matrix would produce a catalog that silently omits a
            // surface, which is the drift this milestone exists to catch.
            Err(error) => panic!("cannot render the `{}` surface: {error}", surface.name),
        }
    }

    let rows: usize = rendered.iter().map(|(_, rows)| rows.len()).sum();
    let hidden: usize = rendered
        .iter()
        .map(|(_, rows)| {
            rows.iter()
                .filter(|row| row.visibility != "visible")
                .count()
        })
        .sum();

    let mut out = String::new();
    out.push_str(GENERATED_HEADER);
    out.push('\n');
    let _ = writeln!(out, "<!-- Regenerate: {UPDATE_COMMAND} -->");
    out.push('\n');
    out.push_str("# Tool Catalog\n\n");
    out.push_str("The model-facing tool surface, emitted by constructing the real registry.\n");
    out.push_str(
        "Each section below is one declared `ToolRegistryOptions` value rendered through\n",
    );
    out.push_str("`ToolRegistry::with_options`, so a row cannot name a tool the binary does not\n");
    out.push_str("register and a registered tool cannot be left out. This file is generated; do\n");
    out.push_str("not edit it by hand.\n\n");
    out.push_str("## What the columns mean\n\n");
    out.push_str("- **Tool** — `Tool::name()`, the canonical identity the broker, the\n");
    out.push_str("  permission boundary and Tool Programs all resolve.\n");
    out.push_str("- **Category** — `Tool::category()`, the static safety class the permission\n");
    out.push_str("  boundary short-circuits on (`ReadOnly` and `SafeMutating` never prompt).\n");
    out.push_str("- **Effect class** — the tool's declared `ToolContract::effect_class`, or the\n");
    out.push_str("  contract's legacy default `non_idempotent` when the tool declares none. The\n");
    out.push_str("  legacy default means *unclassified*, not *destructive*: it is what a tool\n");
    out.push_str("  that has not adopted the contract surface reports.\n");
    out.push_str("- **Defer** — `Tool::defer_loading()`: `yes` means the tool is discoverable\n");
    out.push_str("  through `tool_search` rather than advertised on every request.\n");
    out.push_str("- **Visibility** — `visible` when `Tool::expose_in_definitions()` is true;\n");
    out.push_str("  otherwise `hidden (<reason>)`.\n\n");
    out.push_str("### Where a hidden row's reason comes from\n\n");
    out.push_str("There is no table of reasons in the renderer. It quotes the tool, in order:\n\n");
    out.push_str("1. a disabled backend's stub advertises its configured refusal in the schema\n");
    out.push_str("   description it hands the model (`Disabled: <reason>`);\n");
    out.push_str(
        "2. a program-only adapter declares `ToolCallerPolicy::ProgrammaticOnly` in its\n",
    );
    out.push_str("   own `ToolContract`;\n");
    out.push_str(
        "3. a tool whose declared disclosure state is `hidden` is never model-visible.\n\n",
    );
    out.push_str("A tool that hides itself and offers none of the three fails the render rather\n");
    out.push_str(
        "than appearing with a blank cell — an unstated reason is a contract gap, not a\n",
    );
    out.push_str("row.\n\n");
    out.push_str("## Tool surfaces\n\n");

    for (surface, rows) in &rendered {
        let _ = writeln!(out, "### {}\n", surface.name);
        let _ = writeln!(out, "{}\n", surface.description);
        out.push_str("| Tool | Category | Effect class | Defer | Visibility |\n");
        out.push_str("| --- | --- | --- | --- | --- |\n");
        for row in rows {
            let _ = writeln!(
                out,
                "| `{}` | {} | {} | {} | {} |",
                row.name,
                row.category,
                row.effect_class,
                if row.defer_load { "yes" } else { "no" },
                row.visibility
            );
        }
        out.push('\n');
    }

    let _ = writeln!(
        out,
        "{rows} rows across {} surfaces, {hidden} of them hidden.\n",
        rendered.len()
    );
    out.push_str("## Non-claims\n\n");
    out.push_str("- The catalog lists names, safety class, effect class, defer-loading and\n");
    out.push_str("  visibility. It carries no schemas or descriptions: those change often and\n");
    out.push_str("  have one authority in the registry itself.\n");
    out.push_str("- It is not the whole surface. The daemon's per-turn registry adds tools a\n");
    out.push_str("  `ToolRegistryOptions` value cannot express: `src/tool/present.rs` needs a\n");
    out.push_str("  workspace identity, a turn id and a durable edit checkpoint, and\n");
    out.push_str("  `src/tool/lsp_preview_apply.rs` needs the daemon-owned checked-apply\n");
    out.push_str(
        "  registry. Session registries add `context_read`, `goal_*` and `work_plan_*`.\n",
    );
    out.push_str("- It describes visibility and metadata, never behaviour: whether a call is\n");
    out.push_str("  permitted is the permission boundary's answer, and whether it succeeds is\n");
    out.push_str("  the backend's.\n");
    out.push_str("- The sentinel workspace root the renderer builds with is lexical. Nothing is\n");
    out.push_str("  read, created, or required, and the path never reaches this file.\n");
    out
}

/// The committed catalog's path.
pub(crate) fn catalog_path() -> PathBuf {
    repo_path("architecture/tool-catalog.md")
}

/// The hand-written surface document's path — the prose the catalog replaces as
/// the enumeration.
pub(crate) fn surface_document_path() -> PathBuf {
    repo_path("architecture/agent-tool-surface.md")
}

/// Resolve a repository-relative path from the root package's manifest dir.
pub(crate) fn repo_path(relative: &str) -> PathBuf {
    Path::new(env!("CARGO_MANIFEST_DIR")).join(relative)
}

/// The first line at which two texts disagree, with both sides quoted.
///
/// A whole-file assertion on a generated artifact prints a diff nobody reads;
/// naming the first divergent line is what tells a reader whether they added a
/// tool, re-gated one, or edited the file.
pub(crate) fn first_divergent_line(committed: &str, rendered: &str) -> String {
    let mut committed_lines = committed.lines();
    let mut rendered_lines = rendered.lines();
    let mut number = 1;
    loop {
        let left = committed_lines.next();
        let right = rendered_lines.next();
        if left != right {
            return format!(
                "line {number}:\n  committed: {}\n  rendered:  {}",
                left.unwrap_or("<end of file>"),
                right.unwrap_or("<end of file>")
            );
        }
        if left.is_none() {
            return format!("line {number}: the two texts are equal");
        }
        number += 1;
    }
}

/// Whether this run may rewrite the catalog, and the refusal that keeps CI from
/// rewriting the artifact it verifies.
pub(crate) fn update_requested(update: Option<&str>, ci: Option<&str>) -> Result<bool, String> {
    let requested = update == Some("1");
    if requested && ci.is_some() {
        return Err(format!(
            "CODEGG_UPDATE_TOOL_CATALOG=1 is refused while CI is set: a CI run must never \
             rewrite the artifact it is verifying. Regenerate locally and commit \
             `architecture/tool-catalog.md` (`{UPDATE_COMMAND}`)."
        ));
    }
    Ok(requested)
}

/// The union of every catalogued tool name, for the checks that need the set
/// rather than the text.
pub(crate) fn catalog_tool_names() -> Vec<String> {
    let mut names = Vec::new();
    for surface in SURFACES {
        let rows = render_rows(surface).unwrap_or_else(|error| {
            panic!("cannot render the `{}` surface: {error}", surface.name)
        });
        for row in rows {
            if !names.contains(&row.name) {
                names.push(row.name);
            }
        }
    }
    names
}

/// The renderer's own checks. No `#[cfg(test)]` gate: this file is compiled
/// only as the `tool_catalog` test target, so the gate would always be true and
/// would decide nothing.
mod tests {
    use super::*;

    /// The `backend-disabled` surface, whose `security` row is a refused backend.
    fn backend_disabled() -> &'static Surface {
        SURFACES
            .iter()
            .find(|surface| surface.name == "backend-disabled")
            .expect("the matrix declares the `backend-disabled` surface")
    }

    #[test]
    fn two_renders_of_one_baseline_are_byte_identical() {
        let first = render_catalog();
        assert!(
            first.starts_with(GENERATED_HEADER) && first.contains("## Tool surfaces\n"),
            "the render must carry its marker and its section block"
        );
        assert_eq!(
            first,
            render_catalog(),
            "the catalog must be a pure function of the registry: no clock, no \
             environment value, no path"
        );
    }

    #[test]
    fn a_hidden_row_quotes_the_reason_its_own_stub_advertises() {
        let registry = build_registry(backend_disabled());
        let stub = registry.get("security").expect("`security` is registered");
        let advertised = stub.parameters()["description"]
            .as_str()
            .expect("the stub advertises a schema description")
            .to_string();
        assert!(
            advertised.starts_with(DISABLED_REFUSAL_PREFIX),
            "a disabled stub must advertise its refusal in its schema, got {advertised:?}"
        );
        let row = render_row(stub).expect("a refused backend renders");
        assert_eq!(
            row.visibility,
            format!("hidden ({})", &advertised[DISABLED_REFUSAL_PREFIX.len()..]),
            "the row must quote the stub's own reason, not a renderer-side string"
        );
    }

    #[test]
    fn a_tool_that_hides_without_a_reason_fails_the_render() {
        // With no resolved root the registry replaces every workspace tool with
        // an `UnrootedTool`, which hides itself and advertises no reason.
        let registry = ToolRegistry::with_options(ToolRegistryOptions::default());
        let unrooted = registry
            .get("read")
            .expect("`read` is registered even without a root");
        assert!(!unrooted.expose_in_definitions());
        let error = render_row(unrooted).expect_err("an unstated reason must not render");
        assert!(
            error.contains("`read`") && error.contains("names no reason"),
            "the failure must name the tool and say what is missing, got {error:?}"
        );
    }

    #[test]
    fn rows_sort_by_name_and_sections_keep_the_declared_order() {
        let rendered = render_catalog();
        // Only the `## Tool surfaces` block holds sections: the column legend
        // above it has a `###` heading of its own, and counting that as a
        // surface would hide a missing section behind an explanation.
        let mut section_order = Vec::new();
        let mut in_block = false;
        let mut current: Option<Vec<String>> = None;
        for line in rendered.lines() {
            if line.starts_with("## ") {
                if let Some(rows) = current.take() {
                    section_order.push(rows);
                }
                in_block = line == "## Tool surfaces";
                continue;
            }
            if !in_block {
                continue;
            }
            if let Some(name) = line.strip_prefix("### ") {
                if let Some(rows) = current.take() {
                    section_order.push(rows);
                }
                current = Some(Vec::new());
                assert!(
                    SURFACES.iter().any(|surface| surface.name == name),
                    "`{name}` is a section the matrix does not declare"
                );
                continue;
            }
            if let Some(rows) = current.as_mut() {
                if let Some(rest) = line.strip_prefix("| `") {
                    let name = rest.split('`').next().unwrap_or_default();
                    rows.push(name.to_string());
                }
            }
        }
        if let Some(rows) = current.take() {
            section_order.push(rows);
        }
        let expected: Vec<&str> = SURFACES.iter().map(|surface| surface.name).collect();
        assert_eq!(
            section_order.len(),
            expected.len(),
            "every declared surface must render one section"
        );
        for (index, rows) in section_order.iter().enumerate() {
            assert!(
                !rows.is_empty(),
                "section `{}` has no rows",
                expected[index]
            );
            let mut sorted = rows.clone();
            sorted.sort();
            assert_eq!(
                rows, &sorted,
                "section `{}` must sort its rows by name",
                expected[index]
            );
        }
    }

    #[test]
    fn the_rendered_text_carries_no_absolute_path_and_no_home_directory() {
        let rendered = render_catalog();
        assert!(
            !rendered.contains(WORKSPACE_ROOT),
            "the sentinel root must never reach the artifact"
        );
        let home = std::env::var("HOME").unwrap_or_default();
        if !home.is_empty() {
            assert!(
                !rendered.contains(home.trim_end_matches('/')),
                "the artifact must not carry a home directory"
            );
        }
        assert!(
            !rendered.lines().any(|line| line.contains(" /")),
            "no row may carry an absolute path"
        );
    }

    #[test]
    fn the_first_divergence_is_the_line_a_reader_needs() {
        let committed = "a\nb\nc\n";
        let rendered = "a\nb\nC\n";
        let report = first_divergent_line(committed, rendered);
        assert!(report.starts_with("line 3:"), "got {report:?}");
        assert!(
            report.contains("committed: c") && report.contains("rendered:  C"),
            "both sides of the divergence must be quoted, got {report:?}"
        );
        let truncated = first_divergent_line(committed, "a\nb\n");
        assert!(
            truncated.contains("committed: c") && truncated.contains("rendered:  <end of file>"),
            "a shorter render must name the missing line, got {truncated:?}"
        );
    }

    #[test]
    fn update_mode_is_refused_while_ci_is_set() {
        assert_eq!(
            update_requested(Some("1"), None),
            Ok(true),
            "a local update run is the documented regeneration path"
        );
        assert_eq!(update_requested(None, Some("true")), Ok(false));
        assert_eq!(update_requested(Some("0"), Some("true")), Ok(false));
        let refusal = update_requested(Some("1"), Some("true"))
            .expect_err("update mode in CI must be refused");
        assert!(
            refusal.contains("must never rewrite the artifact"),
            "the refusal must say why, got {refusal:?}"
        );
    }
}
